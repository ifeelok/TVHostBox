<?xml version="1.0" encoding="utf-8"?>
<!--
  10-foot UI 版式：整页留 44dp 安全边距（1080p 上约 5%，避开电视 overscan 被裁边），
  顶部品牌栏 → 页签 → 内容 → 底部键位提示，四段固定，内容区吃满剩余高度。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="44dp"
    android:paddingEnd="44dp"
    android:paddingTop="16dp"
    android:paddingBottom="6dp"
    android:background="#0A1120">

    <!-- ===== 顶栏：品牌 + root 状态 ===== -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/brand_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="H"
            android:textColor="#08131F"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/brand_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="电视Host管家"
                android:textColor="#E8EDF6"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/brand_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="hosts 管理 · 手机配置 · Cloudflare 优选"
                android:textColor="#7E8CA3"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 状态胶囊：图标 + 文字，不只靠颜色传达状态（色弱用户也看得懂） -->
        <LinearLayout
            android:id="@+id/root_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <ImageView
                android:id="@+id/root_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="7dp" />

            <TextView
                android:id="@+id/root_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在检测 root …"
                android:textColor="#93A1B8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 有新版本时才出现：默认 GONE，不占位。只做提示，操作入口在「检查更新」按钮 -->
        <TextView
            android:id="@+id/update_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 顶栏下的一条细线：左浓右淡，给画面一点层次 -->
    <View
        android:id="@+id/hair_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp" />

    <!-- ===== 页签：紧凑左对齐，不平分整行 =====
         以前三个页签各占 1/3 屏宽：焦点块横跨 600px、非激活页签漂在大片空白里没有按钮形态。
         改成 wrap 内容宽 + 固定间距后，焦点块贴住文字，剩余空间还给内容区。 -->
    <LinearLayout
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/nav_hosts"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:stateListAnimator="@null"
            android:text="Hosts 管理"
            android:textSize="16sp" />

        <Button
            android:id="@+id/nav_qr"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:stateListAnimator="@null"
            android:text="扫码配置"
            android:textSize="16sp" />

        <Button
            android:id="@+id/nav_cf"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:stateListAnimator="@null"
            android:text="CF 优选"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 内容区：由代码动态填充 -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ===== 底部按键提示：键帽 + 说明，跟着焦点位置变，遥控器不用猜能按什么 ===== -->
    <LinearLayout
        android:id="@+id/hint_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/hint_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </LinearLayout>
</LinearLayout>
