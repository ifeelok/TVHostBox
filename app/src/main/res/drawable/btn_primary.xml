<?xml version="1.0" encoding="utf-8"?>
<!-- 主操作按钮（开始优选 / 保存这类）：渐变蓝，比普通按钮更突出 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:startColor="#4FA0FF" android:endColor="#2F7CF6"
                android:angle="0" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#265FBF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#3E8BFF" android:endColor="#2F7CF6"
                android:angle="0" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
