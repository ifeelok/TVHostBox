<?xml version="1.0" encoding="utf-8"?>
<!-- 页签（未激活）：低饱和度底板；聚焦时描边变亮，避免和激活态混淆 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#1B2C42" />
            <stroke android:width="2dp" android:color="#4FC3F7" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1B2C42" />
            <stroke android:width="2dp" android:color="#4FC3F7" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#141D2B" />
            <stroke android:width="1dp" android:color="#243147" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
